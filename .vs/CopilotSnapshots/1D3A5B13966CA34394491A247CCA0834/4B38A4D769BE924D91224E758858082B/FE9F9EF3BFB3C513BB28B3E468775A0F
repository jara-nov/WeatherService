FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["WeatherService.Server/WeatherService.csproj", "WeatherService.Server/"]
RUN dotnet restore "WeatherService.Server/WeatherService.csproj"
COPY . .
WORKDIR "/src/WeatherService.Server"
RUN dotnet publish "WeatherService.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "WeatherService.dll"]